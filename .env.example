# Copy to .env and fill in. Never commit the real .env.

# Anthropic API key for scoring posts and drafting replies (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# Optemate pipeline board (same key as the pipeline's .env.local MCP_API_KEY)
MCP_API_KEY=
MCP_URL=http://localhost:3000/api/mcp


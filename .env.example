# Copy to .env and fill in. Never commit the real .env.

# Optemate pipeline board (same key as the pipeline's .env.local MCP_API_KEY)
MCP_API_KEY=
MCP_URL=http://localhost:3000/api/mcp

# Scoring. Default is the Claude Code CLI in headless mode, which uses the Claude subscription
# of whoever is logged in to `claude` on this machine. No API key needed.
# SCORER=claude-code
# CLAUDE_MODEL=sonnet          # or opus

# Alternative: pay-per-token API. Set both lines.
# SCORER=api
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# Optional
# SUBREDDITS=smallbusiness,Entrepreneur,sweatystartup,Contractor,Bookkeeping,Hairstylist,Photography,restaurateur,msp,HVAC,Plumbing,electricians,landscaping,Autobody,cleaningbusiness,lawncare,smallbusinessuk
# MIN_SCORE=4
# INTERVAL_MIN=60
# OUT_FILE=./matches.csv
# REDDIT_USER_AGENT=optemate-monitor/2.0 (read-only feed reader; contact optemate@gmail.com)
